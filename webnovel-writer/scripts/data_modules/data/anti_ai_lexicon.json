{
  "version": 1,
  "description": "反 AI 写作词库单一真源。由 anti_ai_scanner 确定性扫描使用；polish-guide.md / anti-ai-guide.md / style-adapter.md 中的词表均应引用本文件，不再各自维护副本。density_per_1k 为每千字命中密度阈值（启发式默认值，建议按题材/作者校准）；advisory=true 的类别为高频常用词，仅作提醒、不计入 ai_flavor 硬风险。",
  "categories": [
    {
      "id": "A", "label": "总结归纳词", "density_per_1k": 0.5,
      "hint": "删掉总结句，用动作或对话结尾，留未闭合的余味。",
      "words": ["综合", "总之", "总而言之", "由此可见", "可以看出", "不难发现", "归根结底", "说到底", "总体来看", "从这个角度看", "换句话说", "简而言之", "概括来说", "由此得出", "结论是", "最终可知", "总的来说", "总括起来", "整体而言", "总体上", "综上"]
    },
    {
      "id": "B", "label": "枚举模板词", "density_per_1k": 0.8,
      "hint": "禁止首先/其次/最后三段式，改成对白/动作/反问混排。",
      "words": ["首先", "其次", "再次", "第一点", "第二点", "其一", "其二", "其三", "一方面", "另一方面", "再者", "最后一步", "下一步"]
    },
    {
      "id": "C", "label": "书面学术腔", "density_per_1k": 0.8,
      "hint": "把抽象动词替换为具体动作+结果。",
      "words": ["某种程度上", "本质上", "意义上", "维度上", "层面上", "体现为", "构成了", "形成了", "实现了", "展开了", "推动了", "促进了", "具备了", "拥有了", "达成了", "呈现出", "表现出", "反映出", "蕴含着", "折射出"]
    },
    {
      "id": "D", "label": "逻辑连接滥用词", "density_per_1k": 3.0, "advisory": true,
      "hint": "删掉多余连接词，靠事件顺序自然推进。",
      "words": ["因此", "因而", "与此同时", "同样地", "对应地", "相应地", "进一步", "更进一步", "从而", "进而", "结果是", "于是乎", "故而", "相较之下", "反过来说"]
    },
    {
      "id": "E", "label": "情绪直述词", "density_per_1k": 0.8,
      "hint": "情绪用生理反应+微动作展示，不堆标签。",
      "words": ["非常愤怒", "非常开心", "非常难过", "五味杂陈", "百感交集", "情绪复杂", "内心震撼", "不由得感慨", "感到无奈", "感到痛苦", "感到欣慰", "感到恐惧", "深受触动", "心潮起伏", "心情沉重", "心情复杂", "心里一暖", "心里一沉", "心中一紧", "不禁一愣", "不由一怔", "内心一震"]
    },
    {
      "id": "F", "label": "动作套话", "density_per_1k": 1.5,
      "hint": "用前置动作或结果替代固定套路动作。",
      "words": ["皱起眉头", "叹了口气", "深吸一口气", "缓缓开口", "沉声说道", "淡淡说道", "冷冷说道", "轻声说道", "嘴角上扬", "嘴角抽了抽", "眼神一凝", "目光一闪", "身形一滞", "脚步一顿", "浑身一震", "心头一跳", "不由后退半步", "猛地转身", "抬手一挥", "缓缓点头", "轻轻摇头", "下意识后退"]
    },
    {
      "id": "G", "label": "环境套话", "density_per_1k": 1.0,
      "hint": "用具体可感细节替代万能氛围句。",
      "words": ["空气仿佛凝固", "气氛骤然紧张", "气压陡然下降", "夜色如墨", "月色如水", "寒风刺骨", "四周一片寂静", "死一般的寂静", "时间仿佛静止", "空间仿佛扭曲", "房间里弥漫着", "唯一的光源", "摇摇欲坠", "压抑得让人喘不过气", "沉默像潮水", "空气中充满了", "就在这一刻", "忽然之间", "刹那间", "顷刻之间"]
    },
    {
      "id": "H", "label": "叙事填充词", "density_per_1k": 0.8,
      "hint": "删掉填充句，信任读者的理解力。",
      "words": ["事实上", "实际上", "某种意义上", "严格来说", "客观而言", "主观上", "一般来说", "通常情况下", "在这种情况下", "在此基础上", "在这个意义上", "从某种角度", "这意味着", "这代表着", "这并不奇怪", "并非偶然", "不可否认", "毋庸置疑"]
    },
    {
      "id": "I", "label": "抽象空泛词", "density_per_1k": 2.5, "advisory": true,
      "hint": "抽象概念落到具体场景/代价上，不空喊。",
      "words": ["蜕变", "升华", "初心", "宏大", "渺小", "信念", "抉择"]
    },
    {
      "id": "J", "label": "机械开场/收尾词", "density_per_1k": 0.4,
      "hint": "删掉旁白式开场/预告式收尾，用场景直接进出。",
      "words": ["故事要从", "让我们把视线", "镜头转到", "与此同时在另一边", "这一切都要从", "命运的齿轮开始转动", "新的篇章开始了", "未完待续", "故事才刚刚开始", "真正的考验还在后面", "一场风暴即将来临", "更大的阴谋正在酝酿", "答案尚未揭晓", "可他不知道的是", "可她不知道的是", "然而一切才刚开始"]
    },
    {
      "id": "K", "label": "神态模板词", "density_per_1k": 1.0,
      "hint": "AI 对所有角色用同一套神态。给每个角色设计专属微动作（咬笔帽=焦虑，拧手表=不耐烦）。",
      "words": ["眸中闪过", "眼底掠过", "瞳孔微缩", "嘴角微微上扬", "嘴角勾起一抹弧度", "眉头微蹙", "眉心微皱", "面色微变", "神色一凝", "目光微闪", "眼神微动", "唇角微翘", "脸色微沉", "面色如常", "不露声色"]
    },
    {
      "id": "L", "label": "万能副词", "density_per_1k": 2.0,
      "hint": "AI 几乎在所有动作前加副词。删掉副词，用前置动作或结果暗示速度/力度。",
      "words": ["缓缓", "淡淡", "微微", "轻轻", "静静", "默默", "悄悄", "慢慢", "渐渐", "暗暗"]
    },
    {
      "id": "M", "label": "内心活动套话", "density_per_1k": 1.0,
      "hint": "删掉'心中暗道'，直接写内心句或用外化行为代替（攥拳=决心，摸下巴=思考）。",
      "words": ["心中暗道", "心中一凛", "心中暗自思量", "心下了然", "心中不由得", "心底涌起一股", "心中升起一丝", "暗自盘算", "暗自揣测", "心中有了计较"]
    },
    {
      "id": "N", "label": "转折/递进模板", "density_per_1k": 0.6,
      "hint": "AI 用固定套路制造转折感，读者一看就知道要反转。用具体事件制造意外。",
      "words": ["话虽如此", "就在此刻", "然而下一刻", "殊不知", "可惜的是", "然而就在这时", "更令人惊讶的是", "更重要的是", "最让他在意的是"]
    }
  ],
  "structural_thresholds": {
    "short_sentence_max_chars": 8,
    "short_sentence_ratio_min": 0.20,
    "sentence_len_std_min": 6.0,
    "single_sentence_paragraph_ratio_min": 0.15,
    "ngram_n": 4,
    "ngram_repeat_min": 4,
    "said_tag_ratio_max": 0.30
  },
  "said_tag_patterns": ["说道", "沉声道", "淡淡道", "冷冷道", "轻声道", "笑道", "问道", "答道", "喝道", "开口道", "缓缓道", "沉声说道", "淡淡说道", "冷冷说道", "轻声说道"]
}
